# ==============================================================================
# PARTE 1 — VARIÁVEIS OBRIGATÓRIAS ANTES DE INSTALAR O SERVIDOR
# ==============================================================================
# Estas variáveis DEVEM estar preenchidas antes de executar ./install-server.sh,
# pois o contêiner Docker do MinIO e as regras de portas dependem delas durante a instalação.

# Porta TCP principal da aplicação Web
PORT=3000

# MiniO (Armazenamento de Objetos S3 para códigos e logs)
MINIO_ENDPOINT=192.168.x.x # IP da máquina hospedeira
MINIO_PORT=9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_senha_segura
MINIO_NAME=arquivos-alunos


# ==============================================================================
# PARTE 2 — VARIÁVEIS DA APLICAÇÃO (PODEM SER CONFIGURADAS DEPOIS DA INSTALAÇÃO)
# ==============================================================================
# Estas variáveis só são necessárias no momento de subir a aplicação (./deploy.sh).
# O servidor pode ser instalado primeiro, e estes valores preenchidos antes do deploy.

# Banco de Dados (MongoDB Atlas ou Instância Local)
MONGO_DB_URI=mongodb+srv://usuario_exemplo:senha_exemplo@cluster-exemplo.mongodb.net/codecheck?retryWrites=true&w=majority

# Autenticação e Criptografia de Sessão
SESSION_SECRET="sua_chave_secreta_de_sessao_exemplo_123456"
LTI_ENCRYPTION_KEY="sua_chave_de_criptografia_lti_exemplo_123456"

# Integração LTI 1.3 / Moodle
LTI_PLATFORM_URL='https://moodle.exemplo.edu.br'
LTI_PLATFORM_NAME='MOODLE-EXEMPLO'
LTI_CLIENT_ID='seu_client_id_exemplo_123'
LTI_AUTH_ENDPOINT='https://moodle.exemplo.edu.br/mod/lti/auth.php'
LTI_TOKEN_ENDPOINT='https://moodle.exemplo.edu.br/mod/lti/token.php'
LTI_KEYSET_ENDPOINT='https://moodle.exemplo.edu.br/mod/lti/certs.php'

# Sandbox de Execução via Kubernetes
K8S_NAMESPACE=default
K8S_IMAGE=gcc:latest

# Limites de Recursos da Aplicação Web (Node.js no Deployment K8s)
APP_CPU_REQUEST=500m
APP_CPU_LIMIT=2000m
APP_MEMORY_REQUEST=512Mi
APP_MEMORY_LIMIT=2Gi

# Isolamento e Recursos dos Containers dos Alunos (Pods Efêmeros)
K8S_CPU_REQUEST=1000m
K8S_CPU_LIMIT=1000m
K8S_MEMORY_REQUEST=512Mi
K8S_MEMORY_LIMIT=512Mi
MAX_CONCURRENT_COMPILATIONS=4

# Configurações do Juiz / Sandbox
COMPILE_TIMEOUT=30000                   # Tempo limite para compilação em ms (30s)
DEFAULT_TIME_LIMIT_MS=5000              # Limite padrão de tempo de execução em ms (5s)
MAX_EXECUTION_TIME_LIMIT_MS=120000      # Limite máximo de tempo de execução em ms (2 min)
MAX_SUBMISSION_HISTORY=10               # Quantidade de submissões mantidas por pasta no MinIO
LIMPEZATMP=30                           # Tempo em minutos para expiração de pastas temporárias
BENCHMARK_ROUNDS=10                     # Número de rodadas para ranking de desempenho
